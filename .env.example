DB_URL=jdbc:mysql://localhost:3306/ABC?useSSL=false&serverTimezone=Asia/Seoul&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JWT
JWT_SECRET=로컬_개발용_시크릿_키_32자_이상으로_설정하세요
JWT_EXPIRATION=86400

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# EPUB 저장소 (db | s3). 로컬은 db로 둔다.
EPUB_STORAGE=db
AWS_REGION=ap-northeast-2
# s3 mode일 때만 필요한 private bucket 이름. access key/secret key는 여기에 넣지 않는다.
EPUB_BUCKET=

# EPUB S3 one-off migration. 기본값 그대로 두고 필요할 때만 별도 process에서 override한다.
EPUB_MIGRATION_ENABLED=false
EPUB_MIGRATION_DRY_RUN=true
EPUB_MIGRATION_BATCH_SIZE=50

# 외부 도서 API (정보나루/네이버/알라딘). 키가 없으면 BOOK_API_ENABLED=false로 둔다.
INFONARU_KEY=
NAVER_CLIENT_ID_1=
NAVER_CLIENT_SECRET_1=
ALADIN_TTB_KEY_1=
BOOK_API_TIMEOUT_MS=5000
BOOK_API_ENABLED=false
