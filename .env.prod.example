# EC2 배포용 환경변수 template. 이 파일을 .env.prod로 복사한 뒤 실제 값을 채운다.
#
# 규칙:
#   - .env.prod는 절대 commit하지 않는다(.gitignore가 .env.* 를 무시한다).
#   - AWS access key / secret key는 여기에 넣지 않는다. EC2 Instance Profile을 사용한다.
#   - 이 파일에는 placeholder만 두고 실제 값을 넣지 않는다.
#   - EC2에서 chmod 600 .env.prod 로 권한을 제한한다.

# Docker image tag (compose.prod.yml에서 사용)
ABC_API_IMAGE=abc-api
ABC_API_TAG=local

SPRING_PROFILES_ACTIVE=prod

# ---- DataSource (private RDS) ----
# sslMode=REQUIRED는 전송 암호화만 보장하고 hostname 검증은 하지 않는 의도적 시연용 설정이다.
# private subnet RDS + EC2 Security Group source 제한이 필수 전제다.
DB_URL=jdbc:mysql://REPLACE_ME.REPLACE_ME.ap-northeast-2.rds.amazonaws.com:3306/abc?sslMode=REQUIRED&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=REPLACE_ME
DB_PASSWORD=REPLACE_ME

# ---- JWT ----
# 32자 이상 랜덤 문자열. 로컬 개발용 값을 재사용하지 않는다.
JWT_SECRET=REPLACE_ME
JWT_EXPIRATION=86400

# ---- CORS ----
CORS_ALLOWED_ORIGINS=https://REPLACE_ME

# ---- EPUB 저장소 ----
# prod는 s3만 허용한다. 값이 s3가 아니거나 bucket이 비면 기동이 실패한다.
EPUB_STORAGE=s3
AWS_REGION=ap-northeast-2
EPUB_BUCKET=REPLACE_ME

# ---- EPUB S3 one-off migration ----
# 일반 배포에서는 항상 false / true 로 둔다. runner를 실행할 때만 별도 process에서 override한다.
EPUB_MIGRATION_ENABLED=false
EPUB_MIGRATION_DRY_RUN=true
EPUB_MIGRATION_BATCH_SIZE=50

# ---- 외부 도서 API ----
# prod 기본 disabled. 키를 넣지 않으면 true로 바꾸지 않는다.
BOOK_API_ENABLED=false
INFONARU_KEY=
NAVER_CLIENT_ID_1=
NAVER_CLIENT_SECRET_1=
ALADIN_TTB_KEY_1=
BOOK_API_TIMEOUT_MS=5000

# ---- Nginx reverse proxy ----
LIBRARY_TRUSTED_PROXIES=127.0.0.1
